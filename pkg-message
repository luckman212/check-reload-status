[
  { type: install
    message: <<EOM
The existing check_reload_status daemon is still running the previous
executable and must be restarted for the newly installed version to
take effect.

Use ONE of the following methods to restart it:

  - Choose option #16 (Restart PHP-FPM) from the pfSense console menu
  - Reboot the firewall
  - Run the following commands:
      pkill -9 check_reload_status
      nice -n20 /usr/local/sbin/check_reload_status
EOM
  }
]
