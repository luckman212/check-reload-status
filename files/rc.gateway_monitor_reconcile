#!/usr/local/bin/php-cgi -f
<?php
/*
 * rc.gateway_monitor_reconcile
 *
 * Re-run gateway monitoring setup after transient interface events have
 * settled. A dependent interface (a GIF tunnel, or an IPv6 address that only
 * became usable once DAD completed) can come up after rc.newwanip already
 * called setup_gateways_monitor(), leaving dpinger without a monitor for it
 * and the gateway stuck in an unknown state. Re-running only the monitoring
 * setup converges that without replaying the whole rc.newwanip workflow.
 *
 * Invoked by check_reload_status once all serialized per-interface work for
 * every interface has finished.
 */

require_once("globals.inc");
require_once("gwlb.inc");
require_once("util.inc");

/* Serialize duplicate convergence passes using pfSense's runtime temp path. */
$lock_path = g_get('tmp_path', '/tmp') . '/rc.gateway_monitor_reconcile.lock';
$fd = fopen($lock_path, "a+");
if ($fd === false) {
	logger(
		LOG_INFO,
		localize_text(
			'Could not open lock file%s', ": {$lock_path}"
		), LOG_PREFIX_GWMON
	);
	exit(1);
}
if (!flock($fd, LOCK_EX | LOCK_NB)) {
	/* Another pass is already running; it will observe the same state. */
	fclose($fd);
	exit(0);
}

logger(
	LOG_NOTICE,
	gettext(
		'Reconciling gateway monitoring after interface recovery'
	), LOG_PREFIX_GWMON
);
setup_gateways_monitor();

flock($fd, LOCK_UN);
fclose($fd);
exit(0);
?>
